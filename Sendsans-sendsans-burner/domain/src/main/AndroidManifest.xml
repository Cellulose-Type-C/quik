<manifest  xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="dev.cellulose.sendsans.contentproviders.MmsPartProvider"
            android:authorities="${applicationId}.mmspart"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true">
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.messagesText"
            android:enabled="true"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/messages_text_file_provider_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="*" android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
